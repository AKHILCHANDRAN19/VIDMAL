# Path to your browser-exported cookies.json file
GEMINI_COOKIES_PATH=/storage/emulated/0/Download/cookies.json

# OR Raw JSON cookie string for cloud/headless servers
# GEMINI_COOKIES_JSON='[{"name":"__Secure-1PSID","value":"..."}]'

# Aspect Ratio: "16:9" (1920x1080) or "9:16" (1080x1920)
ASPECT_RATIO=16:9
FPS=30
OUTPUT_DIRECTORY=/storage/emulated/0/Download
